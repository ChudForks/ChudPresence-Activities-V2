{
  "id": "prime-video",
  "name": "Prime Video",
  "description": "Show Prime Video movies and episodes, matching artwork, playback state and progress.",
  "version": "2.0.0",
  "apiVersion": 2,
  "minExtensionVersion": "2.0.0",
  "author": {
    "name": "ChudPresence"
  },
  "category": "video",
  "defaultMediaKind": "video",
  "aliases": [
    "Amazon Prime Video",
    "Amazon Video"
  ],
  "tags": [
    "movies",
    "tv",
    "streaming"
  ],
  "serviceUrl": "https://www.primevideo.com/",
  "matches": [
    "https://www.primevideo.com/*",
    "https://primevideo.com/*",
    "https://www.amazon.com/gp/video/*",
    "https://amazon.com/gp/video/*"
  ],
  "entry": "activity.js",
  "icon": "icon.png",
  "frames": "top",
  "network": [],
  "settingsUi": {
    "statusLabels": {
      "app": "Prime Video",
      "artist": "Title",
      "track": "Episode"
    }
  },
  "pageAccess": {
    "url": true,
    "media": true,
    "selectors": {
      "playerSurface": {
        "selector": ".dv-player-fullscreen .atvwebplayersdk-video-surface:has(video)",
        "read": "text"
      },
      "title": {
        "selector": ".dv-player-fullscreen .atvwebplayersdk-title-text",
        "read": "text"
      },
      "episode": {
        "selector": ".dv-player-fullscreen .atvwebplayersdk-episode-info",
        "read": "text"
      },
      "advertisement": {
        "selector": ".dv-player-fullscreen :is(.atvwebplayersdk-ad-timer, .atvwebplayersdk-adtimeindicator-text)",
        "read": "text"
      },
      "detailTitle": {
        "selector": "#main .DVWebNode-detail-atf-wrapper h1",
        "read": "text"
      },
      "detailLogoTitle": {
        "selector": "#main .DVWebNode-detail-atf-wrapper h1 img",
        "read": "attribute",
        "attribute": "alt"
      },
      "showImage": {
        "selector": "#main .DVWebNode-detail-atf-wrapper img:not(h1 img)",
        "read": "attribute",
        "attribute": "src"
      },
      "showImageAlt": {
        "selector": "#main .DVWebNode-detail-atf-wrapper img:not(h1 img)",
        "read": "attribute",
        "attribute": "alt"
      },
      "episode1Label": {
        "selector": "#main #tab-content-episodes [id^=\"av-ep-episode-\"]:nth-child(1) a[data-testid=\"episodes-playbutton\"]",
        "read": "attribute",
        "attribute": "aria-label"
      },
      "episode1Title": {
        "selector": "#main #tab-content-episodes [id^=\"av-ep-episode-\"]:nth-child(1) h3",
        "read": "text"
      },
      "episode1Image": {
        "selector": "#main #tab-content-episodes [id^=\"av-ep-episode-\"]:nth-child(1) [data-testid=\"episode-image\"] img",
        "read": "attribute",
        "attribute": "src"
      },
      "episode2Label": {
        "selector": "#main #tab-content-episodes [id^=\"av-ep-episode-\"]:nth-child(2) a[data-testid=\"episodes-playbutton\"]",
        "read": "attribute",
        "attribute": "aria-label"
      },
      "episode2Title": {
        "selector": "#main #tab-content-episodes [id^=\"av-ep-episode-\"]:nth-child(2) h3",
        "read": "text"
      },
      "episode2Image": {
        "selector": "#main #tab-content-episodes [id^=\"av-ep-episode-\"]:nth-child(2) [data-testid=\"episode-image\"] img",
        "read": "attribute",
        "attribute": "src"
      },
      "episode3Label": {
